PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://username:password@localhost:5432/kslu_circle?schema=public
JWT_SECRET=kslu_circle_super_secret_key_change_me_in_production
JWT_EXPIRE=7d
COOKIE_EXPIRE=7
CLIENT_URL=http://localhost:5173

# Cloudinary Config (If empty, uploads will default to local folder backend/uploads/)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail Config (SMTP/Nodemailer) (If empty, mails will log to console)
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@kslucircle.com
FROM_NAME=KSLU Circle

# Google Drive PYQ Storage Integration
# Root Folder ID of "KSLU CIRCLE – PYQs"
GOOGLE_DRIVE_PYQ_ROOT_FOLDER_ID=

# Provide Service Account credentials via Option A, B, or C:
# Option A: Base64 encoded Service Account JSON (Recommended for cloud deployments like Render)
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

# Option B: Local filesystem path to service account key file (e.g., config/google-service-account.json)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=

# Option C: Individual service account credentials
GOOGLE_SERVICE_ACCOUNT_CLIENT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
