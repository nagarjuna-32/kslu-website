datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String          @id @default(uuid())
  name                    String
  email                   String          @unique
  password                String?
  googleId                String?         @unique
  avatar                  String          @default("")
  role                    String          @default("user")
  isVerified              Boolean         @default(false)
  isBanned                Boolean         @default(false)
  totalDownloads          Int             @default(0)
  totalUploads            Int             @default(0)
  reputation              Int             @default(0)
  emailPref               Boolean         @default(true)
  inAppPref               Boolean         @default(true)
  digestPref              Boolean         @default(false)
  verificationToken       String?
  verificationTokenExpire DateTime?
  resetPasswordToken      String?
  resetPasswordExpire     DateTime?
  lastActive              DateTime        @default(now())
  createdAt               DateTime        @default(now())

  // Relations
  materialsUploaded       StudyMaterial[] @relation("UploadedBy")
  materialsApproved       StudyMaterial[] @relation("ApprovedBy")
  notifications           Notification[]
  announcements           Announcement[]
  activityLogs            ActivityLog[]
  bookmarks               Bookmark[]
  upvotedMaterials        StudyMaterial[] @relation("UpvotesRelation")
  downvotedMaterials      StudyMaterial[] @relation("DownvotesRelation")
  pyqSyncLogs             PyqSyncLog[]    @relation("PyqSyncTriggeredBy")
}

model StudyMaterial {
  id              String       @id @default(uuid())
  title           String
  type            String       // "note" or "paper"
  subjectCode     String
  subjectName     String?
  semester        Int
  university      String       // "KSLU", "NLSIU", "Christ", "Other"
  course          String       @default("3-Year LL.B")
  marks           Int          @default(80)
  year            Int?
  description     String?
  tags            String?      // Store comma-separated tags
  fileUrl         String
  filePublicId    String
  fileSize        Int?
  fileType        String       @default("application/pdf")
  status          String       @default("pending") // "pending", "approved", "rejected"
  rejectionReason String?
  downloads       Int          @default(0)
  views           Int          @default(0)
  upvotes         Int          @default(0)
  downvotes       Int          @default(0)
  isFeatured      Boolean      @default(false)
  isPopular       Boolean      @default(false)
  approvedAt      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  uploadedById    String
  uploadedBy      User         @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: Cascade)
  approvedById    String?
  approvedBy      User?        @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  upvotedBy       User[]       @relation("UpvotesRelation")
  downvotedBy     User[]       @relation("DownvotesRelation")
  bookmarks       Bookmark[]
}

model Notification {
  id          String   @id @default(uuid())
  type        String   // "approval", "rejection", "download", "announcement", etc.
  title       String
  message     String
  link        String?
  metadata    String?  // JSON string
  isRead      Boolean  @default(false)
  isEmailSent Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  type        String    @default("info") // "info", "warning", "success", "urgent"
  isActive    Boolean   @default(true)
  isGlobal    Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  // Relations
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String   // "upload", "download", etc.
  targetId   String?
  targetType String?
  details    String?  // JSON string
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  // Relations
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Bookmark {
  id         String        @id @default(uuid())
  createdAt  DateTime      @default(now())

  // Relations
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
}

model Course {
  id              String       @id @default(uuid())
  name            String       @unique // e.g. "3-Year LL.B", "B.A. LL.B", "B.B.A. LL.B"
  code            String       @unique // slug e.g. "3-year-llb", "ba-llb", "bba-llb"
  totalSemesters  Int          @default(6)
  driveFolderId   String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  semesters       Semester[]
  pyqs            PYQ[]
}

model Semester {
  id              String       @id @default(uuid())
  semesterNumber  Int          // 1 to 10
  name            String       // e.g. "Semester 1"
  driveFolderId   String?
  courseId        String
  course          Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  subjects        Subject[]
  pyqs            PYQ[]

  @@unique([courseId, semesterNumber])
}

model Subject {
  id              String       @id @default(uuid())
  name            String       // e.g. "Constitutional Law - I"
  code            String?      // e.g. "KSLU-3Y-101"
  driveFolderId   String?
  semesterId      String
  semester        Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  schemes         SubjectScheme[]
  pyqs            PYQ[]

  @@unique([semesterId, name])
}

model SubjectScheme {
  id              String       @id @default(uuid())
  name            String       // "Scheme 80 Marks", "Scheme 100 Marks"
  marks           Int          // 80 or 100
  driveFolderId   String?
  subjectId       String
  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  pyqs            PYQ[]

  @@unique([subjectId, marks])
}

model PYQ {
  id                  String         @id @default(uuid())
  title               String         // fileName or parsed display title
  fileName            String
  driveFileId         String         @unique // unique Google Drive file ID
  driveFolderId       String?        // Scheme folder ID
  driveWebViewLink    String?
  mimeType            String         @default("application/pdf")
  fileSize            Int?
  driveModifiedTime   DateTime?
  examYear            Int?           // Year if identifiable from filename (e.g. 2022, 2023)
  examSession         String?        // Month/session if identifiable (e.g. "June", "Dec", "Jan")
  isAvailable         Boolean        @default(true) // false if missing in a successful scan
  downloads           Int            @default(0)
  views               Int            @default(0)
  lastSyncedAt        DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relational hierarchy
  schemeId            String
  scheme              SubjectScheme  @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  subjectId           String
  subject             Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  semesterId          String
  semester            Semester       @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  courseId            String
  course              Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, semesterId])
  @@index([subjectId])
  @@index([schemeId])
  @@index([examYear])
  @@index([isAvailable])
}

model PyqSyncLog {
  id                  String       @id @default(uuid())
  syncType            String       @default("full") // "full" or "incremental"
  status              String       // "running", "completed", "failed"
  filesFound          Int          @default(0)
  filesImported       Int          @default(0)
  filesUpdated        Int          @default(0)
  filesUnavailable    Int          @default(0)
  errorsCount         Int          @default(0)
  errorDetails        String?      // Summary or error message
  changeToken         String?      // Next change page token for incremental sync
  startedAt           DateTime     @default(now())
  completedAt         DateTime?
  triggeredById       String?
  triggeredBy         User?        @relation("PyqSyncTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
}
